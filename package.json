{
	"name": "pro-api-sdk",
	"type": "module",
	"version": "1.6.2",
	"description": "JLCEDA & EasyEDA Professional Extension API Development Toolkit",
	"author": "JLCEDA <support@lceda.cn>",
	"license": "Apache-2.0",
	"homepage": "https://pro.lceda.cn/",
	"bin": {
		"create-easyeda-api-sdk": "./scripts/create.js"
	},
	"engines": {
		"node": ">=20.17.0"
	},
	"scripts": {
		"postinstall": "patch-package",
		"compile": "rimraf ./dist/ && ts-node ./config/esbuild.prod.ts",
		"lint": "eslint",
		"fix": "eslint --fix",
		"build": "npm run compile && ts-node ./scripts/packaged.ts",
		"debug": "ts-node ./scripts/dev.ts",
		"update:check": "ts-node ./scripts/update.ts check",
		"update": "ts-node ./scripts/update.ts update && npm install",
		"manifest:generate": "npm install && ts-node ./scripts/manifest.ts generate",
		"manifest:bump": "npm install && ts-node ./scripts/manifest.ts bump && npm install"
	},
	"dependencies": {
		"@tracespace/parser": "^5.0.0-alpha.0",
		"@tracespace/plotter": "^5.0.0-alpha.0",
		"@tracespace/renderer": "^5.0.0-alpha.0",
		"jszip": "^3.10.1"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^5.4.1",
		"@jlceda/pro-api-types": "^0.3.11",
		"@types/fs-extra": "^11.0.4",
		"@types/ws": "^8.5.13",
		"esbuild": "^0.24.2",
		"eslint": "^9.37.0",
		"fs-extra": "^11.3.0",
		"ignore": "^7.0.3",
		"lint-staged": "^16.2.3",
		"patch-package": "^8.0.1",
		"rimraf": "^6.0.1",
		"simple-git-hooks": "^2.13.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.7.3",
		"ws": "^8.18.0"
	},
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged"
	},
	"lint-staged": {
		"*": "eslint --fix"
	}
}
